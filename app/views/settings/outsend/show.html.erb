<% @page_title = "Outsend" %>
<% can_write = Current.user.can?("settings:write") %>

<%= render "layouts/shared/page_header", title: "Outsend" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "settings_form", capability: "settings:write" %>
<% end %>

<%= form_with url: settings_outsend_path, id: "settings_form", method: :patch, scope: :settings do |form| %>
  <%= tag.fieldset class: "space-y-6", disabled: !can_write do %>
    <section class="<%= ui(:panel, "space-y-5 p-6") %>">
      <div class="space-y-1">
        <h2 class="<%= ui(:heading) %>">API key</h2>
        <p class="text-sm text-gray-500">
          <% if @key_saved %>
            The CMS sends its email through Outsend with the saved key.
          <% else %>
            Until a key is saved, email goes out as the install is set up to send it.
          <% end %>
          Mail is sent from addresses on a domain your Outsend account has verified.
        </p>
      </div>
      <%= settings_field "Outsend API key" do %>
        <%= form.password_field :api_key, class: "w-full font-mono", autocomplete: "new-password", placeholder: (@key_saved ? "Saved — leave blank to keep" : ""), data: { "1p-ignore": true } %>
      <% end %>
    </section>
  <% end %>
<% end %>

<% if @key_saved && can_write %>
  <%= button_to "Remove the API key", settings_outsend_path, method: :delete, class: ui(:button, :danger, "mt-6"), form: { data: { turbo_confirm: "Stop sending email through Outsend?" } } %>
<% end %>
